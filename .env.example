# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: only on the server (Vercel env var), never in the browser or in git
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used in e-mail confirmation links
NEXT_PUBLIC_SITE_URL=https://schildersconnect.nl

# Demo bar for testing (set to false before launch)
DEMO_MODE=true

# Payments: Mollie API key (test_... for testing, live_... after verification)
MOLLIE_API_KEY=

# E-mail via SMTP (e.g. Gmail with an app password, later your own domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SchildersConnect <jouwadres@gmail.com>
ADMIN_EMAIL=
CONTACT_EMAIL=

# Company details on invoices and legal pages (after KvK registration)
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_KVK=
COMPANY_VAT=
COMPANY_IBAN=
